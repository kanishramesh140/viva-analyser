# Copy this file to .env and adjust as needed.

# Port the local server listens on.
PORT=4000

# Origin the Vite dev server runs on, for cookie-based auth during
# development. Not needed in production (client is served from this same
# origin — see README section 5).
CLIENT_ORIGIN=http://localhost:5173

# AI mode for dynamically-generated (non-preset) subjects:
#   auto     - use a local Ollama model if one is running, otherwise fall
#              back to the offline template generator (default)
#   ollama   - require a local Ollama model; fail clearly if unreachable
#   fallback - never use Ollama, always use the offline template generator
AI_MODE=auto

# Local Ollama server (only used if AI_MODE is "auto" or "ollama").
# Install from https://ollama.com and run: ollama pull llama3.2:1b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
